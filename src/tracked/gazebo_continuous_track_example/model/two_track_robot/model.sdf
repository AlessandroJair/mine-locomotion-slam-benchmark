    <joint name='left_track_straight_segment_joint0' type='prismatic'>
      <child>left_track_straight_segment_link0</child>
      <parent>left_body</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <use_parent_model_frame>0</use_parent_model_frame>
