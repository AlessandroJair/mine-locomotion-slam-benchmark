    <!-- ================= VELODYNE LIDAR ================= -->
    
    <joint name='velodyne_base_mount_joint' type='fixed'>
      <parent>body</parent>
      <child>velodyne_base_link</child>
    </joint>

    <link name='velodyne_base_link'>
      <!-- SENSOR STANDARDIZATION.  MUST MATCH the
           velodyne_base_mount_joint origin in
           urdf_xacro/two_track_robot.urdf.xacro.  THIS file is what Gazebo
           spawns (see the note above the spawner in
           launch/lcmine_two_track_world.launch); the xacro is only what
           robot_state_publisher turns into TF.

           Until 2026-08-26 this pose still held the NATIVE 0.35 while the
           xacro had been standardized to 0.6091, so this platform's rays
           actually left 0.5657 m above the track contact plane - 0.26 m lower
           than the other two, exactly the difference the standardization
           exists to remove - and the cloud was then transformed as if they had
           left 0.8248 m up.  The standardization pass edited the xacro because
           that is the file the other two platforms are described in; on this
           platform it is not the one that reaches Gazebo.

             z = 0.6700 + (-0.210) - 0.0377 = 0.4223

           MEASURED, not derived.  Standing this robot on a flat floor at z = 0 and
           letting it settle, `body` and the sprocket axles come to rest at
           z = 0.2100 - so the vehicle rides 0.210 m above the ground, not the
           0.178 m of the sprocket radius that the first standardization pass
           used.  It rests on the BELT: the track trajectory runs at 0.2 m from
           the axle and gazebo_continuous_track hangs its 0.02 m elements on
           that line, so the contact surface is 0.2 + 0.01 = 0.210 m down.  The
           sprocket never touches anything.  None of that can be read off this
           file - the elements only exist once the plugin has run - which is
           why it is measured and then declared in sim_config.yaml
           (contact_plane.tracked).

           0.9000 m is the ray-origin height above the contact plane shared by
           the three platforms, raised from 0.8248 m so the lowest of the 16
           rings clears the robot's own geometry once the sliced LiDAR's wedge
           moves onto a link of its own (see README section 1.5); 0.0377 m is
           the Velodyne's own <sensor><pose>.  The 0.1 kg sensor mass is kept
           at the new height and the mast is treated as massless. -->
      <pose relative_to="body">0 0 0.4843 0 0 0</pose>
      <inertial>
        <mass>0.825345</mass>
        <inertia>
          <ixx>0.000853</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.000853</iyy>
          <iyz>0.000000</iyz>
          <izz>0.001032</izz>
        </inertia>
      </inertial>
      
      <collision name='velodyne_base_collision'>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name='velodyne_base_visual'>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
      <!-- Sensor LiDAR -->
      <sensor name='velodyne-VLP16' type='gpu_ray'>
        <pose>0 0 0.0377 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1875</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>101.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.011314</stddev>
          </noise>
        </ray>
        
        <plugin name='gazebo_ros_laser_controller' filename='libgazebo_ros_velodyne_gpu_laser.so'>
          <topicName>/velodyne_points</topicName>
          <frameName>example_two_track/velodyne_base_link</frameName>
          <min_range>0.9</min_range>
          <max_range>100.0</max_range>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </link>

    <!-- ================= IMU ================= -->
    
    <link name='imu_link'>
      <!-- SENSOR STANDARDIZATION: EL IMU VA EN EL CENTRO DE MASAS.
           Igualar la ALTURA SOBRE EL SUELO es la regla correcta para el LiDAR
           y la camara -lo que ven depende de su altura- y la equivocada para
           un inercial: un acelerometro mide

               a_sensor = a_cm + alpha x r + omega x (omega x r)

           con r desde el CENTRO DE MASAS.  Con la altura igualada los brazos
           quedaban en 0.360 / 0.485 / 0.238 m (husky / tracked / rocker), un
           factor 2.04, porque los tres tienen el CM a alturas muy distintas
           (0.343 / 0.212 / 0.459 m): con el mismo balanceo de chasis el IMU
           del tracked leia el doble de termino de brazo que el del rocker, y
           eso no es una propiedad de la locomocion.

           r = 0 y no un |r| comun: alpha x r depende del VECTOR r, no de su
           modulo, asi que dos brazos iguales en modulo y distintos en
           direccion siguen midiendo cosas distintas.  El unico r comun a las
           tres que ademas es canonico es el cero.

           El punto es el CM del robot SIN el IMU (solucion exacta de
           p = c(p); el IMU pesa 0.0149 kg de 45).  Recalcular si cambia
           cualquier masa. -->

           OJO CON ESTE MODELO EN CONCRETO: su CM declarado no coincide con el
           del xacro (15.6 mm en x).  Aqui los idlers estan lumpeados dentro de
           left_body/right_body PERO SIN desplazar el origen inercial, asi que
           su masa cuenta en x = 0 en vez de en x = -0.35, mientras el sprocket
           sigue siendo un link propio en x = +0.35.  Los 2.00 kg de sprocket
           sin compensar dan 2.00*0.35/45 = 15.6 mm.  El numero de abajo es el
           CM que Gazebo SIMULA, que es el que ve el acelerometro.  Y los
           elementos de oruga que gazebo_continuous_track crea al cargar no
           estan en ningun fichero: si llevan masa, el CM real se mueve un
           poco mas y esto habria que medirlo en el banco.

           MUST MATCH the imu_joint origin in
           urdf_xacro/two_track_robot.urdf.xacro. -->
      <pose relative_to="body">0.015658 0.000000 0.008978 0 0 0</pose>
      <inertial>
        <mass>0.0149159</mass>
        <inertia>
          <ixx>3.60467583e-06</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>3.60467583e-06</iyy>
          <iyz>0.000000</iyz>
          <izz>6.21495833e-06</izz>
        </inertia>
      </inertial>
      
      <collision name='imu_collision'>
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
      </collision>
      
      <visual name='imu_visual'>
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      
      <!-- Sensor IMU -->
      <sensor name='imu_sensor' type='imu'>
        <always_on>1</always_on>
        <!-- 200 -> 100 Hz el 2026-08-24.  Esta era la UNICA tasa de sensor
             que no coincidia entre plataformas: el differential
             (model/differential/model.sdf) y el rocker_bogie
             (urdf/ensamblajeurdf.gazebo) declaran 100, y el propio xacro de
             esta plataforma (two_track_robot_gazebo.urdf.xacro) tambien - pero
             lo que se spawnea es ESTE SDF, asi que el tracked le estaba dando
             a rtabmap el doble de muestras de IMU que las otras dos.  Con
             Imu/Enable y wait_imu_to_init activos eso no es neutro para la
             comparacion.  sim_config.yaml declara el RUIDO del IMU pero no su
             tasa, y check_sim_parity.py no revisa tasas de sensor: por eso
             paso desapercibido. -->
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>__default_topic__</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <plugin name='imu_plugin' filename='libgazebo_ros_imu_sensor.so'>
          <topicName>/imu/data_raw</topicName>
          <bodyName>imu_link</bodyName>
          <updateRateHZ>100.0</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>example_two_track/imu_link</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>
    </link>

    <joint name='imu_joint' type='fixed'>
      <parent>body</parent>
      <child>imu_link</child>
    </joint>

    <!-- La camara ya no es un link: vive dentro de <link name='body'>,
         arriba del todo.  Ver la nota de CAMARA FUSIONADA alli. -->

  </model>
  
</sdf>