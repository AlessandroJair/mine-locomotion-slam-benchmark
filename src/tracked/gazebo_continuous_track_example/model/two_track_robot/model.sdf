          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>

    <!-- BANDA A 0.148 DE LA CARA EXTERIOR (2026-09-17).
         make_arc_segment_link_template impone que el cilindro del arco tenga
         el MISMO radio que la distancia del origen del link al eje: pose
         '0 0 -radius' y cilindro de ese radius, tangente a los tramos rectos.
         El fichero tenia la trayectoria en 0.170 y el cilindro en 0.2, asi que
         el tambor sobresalia 20 mm POR DEBAJO de la banda y era lo unico que
         tocaba el suelo: el vehiculo se apoyaba en cuatro cilindros convexos
         en x=+-0.35 y los elementos motrices flotaban.  De ahi los 5 intentos
         'wedged' de metrics_VF (-0.59 rad/s mandados, 0.019 rad girados en
         25 s).  El plugin no lo salvaba: PopulateBaseSegmentLinkSDFs clona el
         link CON su colision y solo anade los elementos encima.

         Cadena de radios, desde el eje del sprocket:
             sprocket / idler (colision)   0.128   = cara INTERNA de la banda
             trayectoria = radio del arco  0.138   = linea media de la banda
             cara exterior de la banda     0.148   = plano de contacto
         pitch_diameter = 2 * 0.138 = 0.276, para que una vuelta de sprocket
         avance justo el perimetro de la linea media.

         El plano de contacto bajo de 0.180 a 0.148, asi que LiDAR, camara y
         sus postes subieron 32 mm para conservar 0.670 / 0.531 sobre el suelo.
         MANTENER EN SINCRONIA con urdf_xacro/two_track_robot*.urdf.xacro. -->
    <link name='left_track_arc_segment_link0'>
      <pose relative_to="left_body">0.35 0 0.138 0 -0 0</pose>
      <inertial>
        <pose>0 0 -0.138 1.5708 -0 0</pose>
        <mass>0.375275</mass>
        <inertia>
          <ixx>0.005004</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.005004</iyy>
          <iyz>0.000000</iyz>
          <izz>0.001501</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 -0.138 1.5708 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.3</length>
            <radius>0.138</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.75</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>1.0</kd>
              <min_depth>0.003</min_depth>
              <max_vel>1.0</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 -0.138 1.5708 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.292</length>
            <radius>0.138</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.3 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <link name='left_track_arc_segment_link1'>
      <pose relative_to="left_body">-0.35 0 -0.138 3.14159 0 3.14159</pose>
      <inertial>
        <pose>0 0 -0.138 1.5708 -0 0</pose>
        <mass>0.375275</mass>
        <inertia>
          <ixx>0.005004</ixx>
