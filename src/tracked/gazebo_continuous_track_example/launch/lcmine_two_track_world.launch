<launch>

    <!-- =====================================================================
         TERRAIN MODEL PATH
         =====================================================================
         lcmine.world instantiates the terrain by URI - model://lc_mine,
         model://grass_plane, model://smaze_wall, model://sun_2 - and those
         models live in this package's world/mine directory.  package.xml only
         exports <pkg>/model to GAZEBO_MODEL_PATH, which holds the robot
         models, not the terrain, so nothing in this repository ever told
         Gazebo where the terrain was.

         It worked anyway because ~/.bashrc exported the directory by hand.
         That is a dependency on one developer's interactive shell, and the
         path it exported pointed at ~/jounal_comparison - a stale duplicate of
         this workspace, with a typo in its name.  Any run that did not source
         that .bashrc (a script, a CI job, a background campaign) got
         "Unable to find uri[model://lc_mine]" and a world with NO GROUND: the
         robot spawns at z and free-falls forever while x and y never change,
         which reads exactly like a robot that refuses to move.

         Declaring it here makes the launch self-contained.  optenv keeps
         whatever the environment already had, so an existing setup is not
         broken by this.
         ===================================================================== -->
    <env name="GAZEBO_MODEL_PATH"
         value="$(find gazebo_continuous_track_example)/world/mine:$(find gazebo_continuous_track_example)/model:$(optenv GAZEBO_MODEL_PATH)" />

    <!-- these are the arguments you can pass this launch file, for example paused:=true -->
    <arg name="paused" default="true" />
    <arg name="use_sim_time" default="true" />
    <arg name="gui" default="true" />
    <arg name="headless" default="false" />
    <arg name="debug" default="false" />

    <!-- =====================================================================
         RANDOM SEED
         =====================================================================
         Gazebo's noise models (the IMU, and the <noise> block of the Velodyne's
         <ray>) draw from ignition::math::Rand.  Left alone, gzserver seeds that
         generator from the system clock, so no run can ever be repeated: the
         sensor noise of a given run exists once and is gone.

         run_campaign.sh passes seed:=<run_id>, so run 1 / 2 / 3 get seeds
         1 / 2 / 3.  The runs still differ from each other - different seeds
         give different noise, which is what the reported standard deviation
         measures - but each one is now anchored and can be reproduced.

         seed:=0 restores clock seeding (gzserver treats 0 as "pick your own").
         ===================================================================== -->
    <arg name="seed" default="0" />

    <!-- We resume the logic in empty_world.launch, changing only the name of the world to be launched -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find gazebo_continuous_track_example)/world/mine/lcmine.world" />
        <arg name="debug" value="$(arg debug)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="use_sim_time" value="$(arg use_sim_time)" />
        <arg name="headless" value="$(arg headless)" />
        <arg name="extra_gazebo_args" value="--seed $(arg seed)" />
    </include>

    <!--
      Spawn pose - MUST match the other two platforms (see sim_config.yaml).
      The robot used to be instantiated by an <include> inside lcmine.world,
      which made the world file differ between packages.  It is now spawned
      here so that the world file is byte-identical for the three robots.
    -->
    <arg name="spawn_x" default="33.5" />
    <arg name="spawn_y" default="0.2" />
    <!-- 1.0 -> 1.35 on 2026-08-21.  At 1.0 this platform spawned INSIDE the
         terrain and the simulation never ran: real-time factor 5.6e-06,
         /gazebo/model_states silent, no error anywhere because nothing is
         illegal about it - just impossible to solve.

         The geometry: the lowest collision point is the sprocket at -0.178 m
         below the root link, the mine floor at (33.5, 0.2) is about 0.937 m, so
         a root at 1.0 starts the sprockets 0.115 m UNDER the ground.  The
         continuous track carries hundreds of collision elements, and hundreds
         of deep interpenetrations against a triangle mesh is what stalls ODE.

         Proof it was the spawn and not the model: the identical robot runs at
         RTF 0.993 in its own example world, whose ground is an analytic plane
         it lands on top of.  Lowering the solver to 50 iterations changed
         nothing, which rules out solver cost.

         1.35 gives 0.235 m of clearance, matching what the other two already
         had (rocker_bogie +0.240, differential +0.420).  z is the per-platform
         drop height and sim_config.yaml states it is not a test condition, but
         it is declared there and check_sim_parity.py section 6 enforces it, so
         it is updated there too. -->
    <arg name="spawn_z" default="0.91" />
    <!-- BAJADA 2026-09-01, de 1.35 a 0.91.  Medido: esta plataforma
         reposa en z = 0.8493, asi que 1.35 dejaba 50 cm de caida.  Con
         el contacto a kp = 1e7 ese impacto hacia GIRAR al Husky
         16.4 grados sobre +z durante el aterrizaje, y esos grados se
         quedaban como condicion inicial de la corrida.  Ahora la
         caida son 6 cm: suficiente para no aparecer dentro del
         terreno, poco para golpear. -->
    <arg name="spawn_Y" default="0.0" />

    <!--
      SPAWNED FROM THE SDF, NOT FROM robot_description.  Do not "modernise"
      this back to `-param ... -urdf`.

      It was `-param example_two_track/robot_description -urdf` for a while, to
      have a single authoritative definition.  The intent was right but the
      mechanism does not survive: `spawn_model -urdf` runs the model through
      sdformat's URDF->SDF conversion, and that conversion cannot express what
      gazebo_continuous_track needs.  Three separate things were lost, each
      failing in a way that does not look like a spawning problem at all:

        <robotNamespace>   The xacro does not declare one, so gazebo_ros_control
                           defaulted its namespace to the Gazebo model name and
                           searched for robot_description under
                           /two_track_robot instead of /example_two_track.
                           getURDF() retries that forever, in a usleep() loop
                           INSIDE Load() - and for a model spawned at runtime
                           Load() runs on the world update thread.  It froze
                           the whole simulation: sim time stuck at 0.001 s,
                           /clock silent, gzserver asleep at 10% CPU, no
                           controller_manager, and a log whose last line is
                           "[right_track]: Loaded plugin".

        left_body /        Attached to body by FIXED joints, which the
        right_body         conversion lumps into the parent, so the belt joints
                           were reparented to body.

        <pose relative_to> This SDF writes <pose relative_to="left_body"> on
                           every belt segment; the conversion emits a bare
                           <pose>, read in the MODEL frame and without
                           composing left_body's transform.  All eight belt
                           links landed at y = 0: BOTH TRACKS ON THE CHASSIS
                           CENTRELINE, visible at a glance in gzclient.

      model.sdf is SDF already, so none of that applies - and it is the same
      arrangement the Husky uses (`-database differential -sdf` in
      lcmine_husky_world.launch) and the one upstream ships.  robot_description
      below still loads the xacro, because gazebo_ros_control reads the joint
      effort limits from it; the two files must be kept in step, and
      check_sim_parity.py section 9 weighs whichever one is spawned.
    -->
    <!-- =====================================================================
         LIDAR: normal (el de siempre) o troceado.  Ver la nota completa en
         differential/launch/lcmine_husky_world.launch.
         =====================================================================
         El modelo troceado se deriva del mismo model.sdf que se spawnea en
         modo normal, asi que no hay una segunda copia que pueda quedarse
         atras - importante justo aqui, donde lo que se spawnea es el SDF y no
         el xacro (ver la nota de arriba).
         ===================================================================== -->
    <arg name="lidar" default="normal" />

    <param name="swept_robot_description"
           if="$(eval arg('lidar') == 'swept')"
           command="$(find robot_metrics)/scripts/retopic_lidar.py
                    $(find gazebo_continuous_track_example)/model/two_track_robot/model.sdf" />

    <node name="spawn_two_track" pkg="gazebo_ros" type="spawn_model"
          unless="$(eval arg('lidar') == 'swept')"
          args="-database two_track_robot -sdf -model two_track_robot
                -x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z) -Y $(arg spawn_Y)"
          output="screen" />

    <node name="spawn_two_track" pkg="gazebo_ros" type="spawn_model"
          if="$(eval arg('lidar') == 'swept')"
          args="-param swept_robot_description -sdf -model two_track_robot
                -x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z) -Y $(arg spawn_Y)"
          output="screen" />

    <!-- Arm swept: el LiDAR monolitico con la distorsion de barrido
         metida por formulas.  Ver sweep_distortion.launch. -->
    <arg name="cut_angle_deg" default="0.0" />
    <arg name="rotor_dir"     default="1" />
    <include file="$(find robot_metrics)/launch/sweep_distortion.launch"
             if="$(eval arg('lidar') == 'swept')">
        <arg name="model_name"    value="two_track_robot" />
        <arg name="base_frame"    value="example_two_track/body" />
        <!-- body, NO base_link: el root link del model.sdf del tracked se
             llama `body`, y es al que se refiere la pose de
             /gazebo/model_states.  El namespace del topic
             (example_two_track) no dice como se llama el link. -->
        <arg name="frame_id"      value="example_two_track/velodyne_base_link" />
        <arg name="cut_angle_deg" value="$(arg cut_angle_deg)" />
        <arg name="rotor_dir"     value="$(arg rotor_dir)" />
    </include>


    <group ns="example_two_track">

        <!-- gazebo 7 has a bug which zeros the velocity of a position-controlled joint in every simulation step. -->
        <!-- a workaround is to set pid gains for these joints like below.                                        -->
        <!-- this enables effort-based position control in the simulated hardware,                                -->
        <!-- instead of directly setting the position of joint                                                    -->
        <!-- DEAD CONFIG, TWICE OVER - do not resurrect it by accident.
             The <!--> markers around the rosparam below are a malformed
             comment pair: the first opens an XML comment and the trailing -->
             of the second closes it, so everything between them is commented
             out and has never reached the parameter server.  The joint names
             in it are wrong anyway (the joints are left_sprocket_axle /
             right_sprocket_axle, not sprocket_axle_left / _right).  Kept only
             because it is the upstream example's Gazebo 7 workaround.  The
             live gains are the ones further down, derived from the shared
             actuation budget.  NOTE: adding a normal --> anywhere between the
             two markers terminates the outer comment early and makes the file
             invalid XML. -->
        <!-->
        <rosparam>
            gazebo_ros_control:
                pid_gains:
                    sprocket_axle_left: {p: 1800.0, i: 0.0, d: 10.0}
                    sprocket_axle_right: {p: 1800.0, i: 0.0, d: 10.0}
        </rosparam>
        <!-->

        <!-- Load the URDF into the ROS Parameter Server -->
        <param name="robot_description" command="xacro --inorder '$(find gazebo_continuous_track_example)/urdf_xacro/two_track_robot_gazebo.urdf.xacro'" />
        
        <rosparam>
            joint_state_controller:
                type: joint_state_controller/JointStateController
                # 10 -> 50 el 2026-09-09.  Los 10 no venian de ningun
                # razonamiento: eran el unico valor de las tres plataformas
                # que nadie habia mirado, porque hasta ahora nada leia
                # joint_states y una disparidad ahi no se notaba en ninguna
                # metrica.  wheel_odometry.py si lo lee, y a 10 Hz el tracked
                # daba una muestra por nube de LiDAR contra las cinco de las
                # otras dos.  Lo comprueba check_sim_parity.py (17).
                publish_rate: 50

            sprocket_velocity_controller_left:
                type: velocity_controllers/JointVelocityController
                joint: left_sprocket_axle

            sprocket_velocity_controller_right:
                type: velocity_controllers/JointVelocityController
                joint: right_sprocket_axle

            gazebo_ros_control:
                #
                # GAINS DERIVED FROM THE SHARED ACTUATION BUDGET, not tuned here.
                # See robot_metrics/config/sim_config.yaml.  What has to match
                # across platforms is the velocity-loop stiffness referred to the
                # contact patch, not the raw joint gain:
                #
                #     K_F = n_driven * p / r^2   [N per m/s of speed droop]
                #     K_I = n_driven * i / r^2
                #
                # The Rocker-Bogie is the anchor because its gains carry a
                # derivation (rescaled by mass_scale so wn and zeta survived the
                # mass matching).  These were p: 18.0 / i: 3.0, inherited from
                # the upstream example package with nothing behind them, which
                # gave this platform K_F = 1136 against the Rocker-Bogie's 2334
                # - half the torque for the same speed error.  The radii are
                # equal, so matching is just the driven-joint count ratio 6/2:
                #
                #     p = 14.790 * 3 = 44.370      i = 4.740 * 3 = 14.220
                #
                # i_clamp IS LOAD-BEARING.  control_toolbox defaults
                # i_clamp_min/max to 0.0, so the i: 3.0 declared before this
                # line was clamped to zero on every step and never contributed:
                # the loop was P-only. The clamp is this joint's own torque
                # ceiling from the budget.
                pid_gains:
                    left_sprocket_axle:
                        p: 26.669
                        i: 25.641
                        d: 0.0
                        i_clamp: 55.946
                    right_sprocket_axle:
                        p: 26.669
                        i: 25.641
                        d: 0.0
                        i_clamp: 55.946
        </rosparam>

        <!-- load and start the controllers -->
        <node name="controller_starter" pkg="controller_manager" type="controller_manager" args="spawn joint_state_controller sprocket_velocity_controller_left sprocket_velocity_controller_right" output="screen" />

        <!-- convert joint states to TF transforms for rviz, etc -->
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen">
            <param name="tf_prefix" value="example_two_track" />
        </node>

        <!-- twist_to_tracks: convierte cmd_vel (Twist) a velocidades de sprockets -->
        <node name="twist_to_tracks" pkg="gazebo_continuous_track_example" type="twist_to_tracks.py" output="screen">
            <param name="track_separation" value="0.5709" />
            <param name="sprocket_radius" value="0.138" />
            <!-- 0.0 for all three platforms; see command.min_angular_rad_s
                 in sim_config.yaml.  This platform used to force 0.25. -->
            <param name="min_angular" value="0.0" />
        </node>
    </group>


    <!-- ================= COVARIANZAS DEL IMU =============================
         gazebo_ros_imu_sensor ata el ruido y la covarianza al mismo parametro
         (<gaussianNoise>): llena las tres diagonales con gaussianNoise^2.
         Aca el ruido tiene que salir del generador SEMBRADO -los bloques
         <noise> del <sensor>, que usan ignition::math::Rand y por tanto
         responden a la opcion seed de gzserver- y no al rand() de C del plugin,
         que la semilla no alcanza.  Por eso <gaussianNoise> esta en 0.0, y el
         efecto colateral fue que las covarianzas quedaron en cero, o sea
         "desconocidas" segun la spec de sensor_msgs/Imu.  RTAB-Map consume
         este topic.

         Solucion: el plugin publica crudo en /imu/data_raw y este nodo
         republica /imu/data con las diagonales puestas desde los stddev de
         sim_config.yaml.  Los consumidores (rtabmap, metrics_logger,
         rearing_guard, wheel_odom) siguen leyendo /imu/data sin cambios.
         Medido/aplicado 2026-08-23. -->
    <!-- AHRS.  Fusiona giroscopo y acelerometro para producir la orientacion que
         consumen rtabmap, metrics_logger y wheel_odometry.py.  Sustituye a
         imu_covariance.py el 2026-09-09: aquel solo rellenaba covarianzas y
         dejaba pasar la orientacion del plugin, que es la pose EXACTA del
         link.  No era verdad de terreno con ruido: la spec de SDF no tiene
         elemento de ruido para la orientacion, asi que `gzserver -seed` no
         tenia ahi nada que sembrar.  Ver la cabecera de imu_ahrs.py. -->
    <node name="imu_ahrs" pkg="robot_metrics" type="imu_ahrs.py"
          output="screen">
        <!-- Sin esto la salida de un nodo Python se queda en el buffer cuando
             roslaunch va redirigido a un archivo, que es como corre la
             campana: el nodo funciona pero su log no aparece hasta que sale.
             Aqui tapaba justo lo que hay que poder auditar, el sesgo del
             giroscopo que se estimo al arrancar. -->
        <env name="PYTHONUNBUFFERED" value="1" />
        <remap from="~input"  to="/imu/data_raw"/>
        <remap from="~output" to="/imu/data"/>
        <param name="angular_velocity_stddev"    value="0.009"/>
        <param name="linear_acceleration_stddev" value="0.021"/>
        <param name="orientation_stddev"         value="0.02"/>
        <param name="tau"                        value="1.0"/>
        <param name="accel_gate"                 value="0.15"/>
        <param name="bias_samples"               value="200"/>
    </node>

</launch>
