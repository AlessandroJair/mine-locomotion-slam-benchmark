<robot name="two_track_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== MASS MATCHING ====================
       Every link mass and every inertia component below is multiplied by
       mass_scale so that the three compared platforms have the same total
       mass (45.0 kg).  This model natively weighed 46.9670 kg, hence
           mass_scale = 45.0 / 46.9670 = 0.958120
       Uniform scaling leaves the centre of gravity and every geometric
       property untouched; only the inertial properties change.  Set
       mass_scale to 1.0 to recover the native model.
       make_box_inertia / make_wheel_inertia / make_track derive the
       tensor from their mass argument, so scaling that argument scales
       the whole tensor.  mass_scale is defined here and reused by
       two_track_robot_gazebo.urdf.xacro, which includes this file and
       holds the 3.0 kg of track bodies.
       ============================================================ -->
    <xacro:property name="mass_scale" value="0.958120"/>


    <!-- URDF file for general ROS systems such as ros_control, rviz, etc.           -->
    <!-- We define here;                                                             -->
    <!--     * a body to be wrapped by the track                                     -->
    <!--     * a sprocket to drive the track                                         -->
    <!--     * an axle and actuator for the sprocket                                 -->
    <!--     * an idler wheel on the other side of the sprocket                      -->
    <!-- Other entities specialized for Gazebo are defined in *_gazebo.urdf.xacro .  -->

    <xacro:macro name="make_box_inertia" params="mass size_x size_y size_z">
        <inertial>
            <mass value="${mass}" />
            <inertia ixx="${mass * (size_y * size_y + size_z * size_z) / 12}" ixy="0" ixz="0" iyy="${mass * (size_z * size_z + size_x * size_x) / 12}" iyz="0" izz="${mass * (size_x * size_x + size_y * size_y) / 12}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="make_wheel_inertia" params="mass radius length">
        <inertial>
            <mass value="${mass}" />
            <!-- assuming axis of cylinder is y, not z -->
            <inertia ixx="${mass * (radius * radius / 4 + length * length / 12)}" ixy="0" ixz="0" iyy="${mass * radius * radius / 2}" iyz="0" izz="${mass * (radius * radius / 4 + length * length / 12)}" />
        </inertial>
    </xacro:macro>

    <!-- ================= MAIN BODY (ROOT LINK) ================= -->

    <link name="body">
        <xacro:make_box_inertia mass="${33.855*mass_scale}" size_x="1.0" size_y="0.57" size_z="0.20" />

        <visual>
            <geometry>
                <box size="1.0 0.57 0.20" />
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="1.0 0.57 0.20" />
            </geometry>
        </collision>
    </link>

    <!-- ================= LEFT TRACK ================= -->

    <!-- body to be wrapped by the track -->

    <link name="left_body">
        <xacro:make_box_inertia mass="${3.0*mass_scale}" size_x="0.65" size_y="0.31" size_z="0.2" />

        <visual>
            <geometry>
                <box size="0.65 0.31 0.2" />
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="0.66 0.3 0.2" />
            </geometry>
        </collision>
    </link>

    <joint name="left_body_joint" type="fixed">
        <origin xyz="0 0.28545 0" rpy="0 0 0" />
        <parent link="body" />
        <child link="left_body" />
    </joint>

    <!-- sprocket driving the track -->

    <link name="left_sprocket">
        <xacro:make_wheel_inertia mass="${1.0*mass_scale}" radius="0.178" length="0.31" />

        <visual>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </visual>
        <visual>
            <geometry>
                <box size="0.01 0.31 0.34" />
            </geometry>
        </visual>
        <visual>
            <geometry>
                <box size="0.34 0.31 0.01" />
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </collision>
    </link>

    <joint name="left_sprocket_axle" type="continuous">
        <origin xyz="0.35 0 0" rpy="0 0 0" />
        <parent link="left_body" />
        <child link="left_sprocket" />
        <axis xyz="0 1 0" />
    </joint>

    <transmission name="left_sprocket_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="left_sprocket_axle">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="left_sprocket_actuator">
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <!-- idler on the other side of the sprocket -->

    <link name="left_idler">
        <xacro:make_wheel_inertia mass="${1.0*mass_scale}" radius="0.178" length="0.31" />

        <visual>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </collision>
    </link>

    <joint name="left_idler_axle" type="fixed">
        <origin xyz="-0.35 0 0" rpy="0 0 0" />
        <parent link="left_body" />
        <child link="left_idler" />
    </joint>

    <!-- ================= RIGHT TRACK ================= -->

    <!-- body to be wrapped by the track -->

    <link name="right_body">
        <xacro:make_box_inertia mass="${3.0*mass_scale}" size_x="0.65" size_y="0.31" size_z="0.2" />

        <visual>
            <geometry>
                <box size="0.65 0.31 0.2" />
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="0.66 0.3 0.2" />
            </geometry>
        </collision>
    </link>

    <joint name="right_body_joint" type="fixed">
        <origin xyz="0 -0.28545 0" rpy="0 0 0" />
        <parent link="body" />
        <child link="right_body" />
    </joint>

    <!-- sprocket driving the track -->

    <link name="right_sprocket">
        <xacro:make_wheel_inertia mass="${1.0*mass_scale}" radius="0.178" length="0.31" />

        <visual>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </visual>
        <visual>
            <geometry>
                <box size="0.01 0.31 0.34" />
            </geometry>
        </visual>
        <visual>
            <geometry>
                <box size="0.34 0.31 0.01" />
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </collision>
    </link>

    <joint name="right_sprocket_axle" type="continuous">
        <origin xyz="0.35 0 0" rpy="0 0 0" />
        <parent link="right_body" />
        <child link="right_sprocket" />
        <axis xyz="0 1 0" />
    </joint>

    <transmission name="right_sprocket_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="right_sprocket_axle">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="right_sprocket_actuator">
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <!-- idler on the other side of the sprocket -->

    <link name="right_idler">
        <xacro:make_wheel_inertia mass="${1.0*mass_scale}" radius="0.178" length="0.31" />

        <visual>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            <geometry>
                <cylinder radius="0.178" length="0.31" />
            </geometry>
        </collision>
    </link>

    <joint name="right_idler_axle" type="fixed">
        <origin xyz="-0.35 0 0" rpy="0 0 0" />
        <parent link="right_body" />
        <child link="right_idler" />
    </joint>

    <!-- ================= VELODYNE LIDAR ================= -->

    <link name="velodyne_base_link">
        <xacro:make_box_inertia mass="${0.1*mass_scale}" size_x="0.1" size_y="0.1" size_z="0.07" />
        
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.05" length="0.07"/>
            </geometry>
            <material name="velodyne_red">
                <color rgba="0.8 0.1 0.1 1.0"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.05" length="0.07"/>
            </geometry>
        </collision>
    </link>

    <joint name="velodyne_base_mount_joint" type="fixed">
        <!-- SENSOR STANDARDIZATION (see robot_metrics/config/sensor_standardization.yaml).
             Native origin was "0 0 0.35", i.e. 0.35 - (-0.178) = 0.528 m above
             the track contact plane. All three platforms are referred to the
             Rocker-Bogie LiDAR height of 0.8248 m so that a given chassis tilt
             displaces every LiDAR by the same amount:
               z = 0.8248 + (-0.178) - 0.0377 = 0.6091
             where 0.0377 m is the Velodyne's own <sensor><pose>, i.e. the
             offset from the mount link origin to the ray origin - the ray
             origin is what has to match across platforms, not the mount.
             The mast carrying the sensor is treated as massless; the 0.1 kg
             sensor mass is kept at the new height. -->
        <origin xyz="0 0 0.6091" rpy="0 0 0" />
        <parent link="body" />
        <child link="velodyne_base_link" />
    </joint>

    <!-- ================= IMU ================= -->
    
    <link name="imu_link">
        <inertial>
            <mass value="${0.001*mass_scale}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="${0.0001*mass_scale}" ixy="${0*mass_scale}" ixz="${0*mass_scale}" iyy="${0.0001*mass_scale}" iyz="${0*mass_scale}" izz="${0.0001*mass_scale}"/>
        </inertial>
        
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 0.02"/>
            </geometry>
            <material name="imu_grey">
                <color rgba="0.3 0.3 0.3 1.0"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 0.02"/>
            </geometry>
        </collision>
    </link>

    <joint name="imu_joint" type="fixed">
        <!-- SENSOR STANDARDIZATION: native "0 0 0.15" = 0.328 m above the
             contact plane. Referred to the Rocker-Bogie IMU height of 0.6969 m:
               z = 0.6969 + (-0.178) = 0.5189 -->
        <origin xyz="0 0 0.5189" rpy="0 0 0"/>
        <parent link="body"/>
        <child link="imu_link"/>
    </joint>

    <!-- ================= CAMERA ================= -->
    
    <link name="camera_link">
        <inertial>
            <mass value="${0.01*mass_scale}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="${0.0001*mass_scale}" ixy="${0*mass_scale}" ixz="${0*mass_scale}" iyy="${0.0001*mass_scale}" iyz="${0*mass_scale}" izz="${0.0001*mass_scale}"/>
        </inertial>
        
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.08 0.03"/>
            </geometry>
            <material name="camera_black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.08 0.03"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint" type="fixed">
        <!-- SENSOR STANDARDIZATION: native "0.52 0 0.25". Referred to the
             Rocker-Bogie camera pose: 0.3543 m ahead of the contact polygon
             centre (which is x = 0 here, midway between sprocket and idler)
             and 0.7607 m above the contact plane:
               z = 0.7607 + (-0.178) = 0.5827 -->
        <origin xyz="0.3543 0 0.5827" rpy="0 0 0"/>
        <parent link="body"/>
        <child link="camera_link"/>
    </joint>

    <!-- Optical frame (importante para ROS - convención de cámaras) -->
    <link name="camera_optical_frame">
        <inertial>
            <mass value="${0.001*mass_scale}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="${0.00001*mass_scale}" ixy="${0*mass_scale}" ixz="${0*mass_scale}" iyy="${0.00001*mass_scale}" iyz="${0*mass_scale}" izz="${0.00001*mass_scale}"/>
        </inertial>
    </link>
    
    <joint name="camera_optical_joint" type="fixed">
        <!-- Rotación para alinear con convención ROS (Z adelante, X derecha, Y abajo) -->
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_link"/>
        <child link="camera_optical_frame"/>
    </joint>

</robot>