Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Reference path1
        - /Ground truth1
        - /SLAM estimate1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 38; 38; 40
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Displays:

    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
      Color: 70; 70; 74
      Alpha: 0.4
      Reference Frame: map

    # ---- the three things this experiment is about --------------------------
    # The reference and the ground truth should stay on top of each other: the
    # controller steers on truth, so any gap between them is follower error.
    # The SLAM estimate is free to wander, and that wandering IS the result.

    - Class: rviz/Path
      Name: Reference path
      Enabled: true
      Topic: /trajectory_follower/reference_path
      Color: 255; 255; 255
      Alpha: 1
      Line Style: Lines
      Buffer Length: 1

    - Class: rviz/Path
      Name: Ground truth
      Enabled: true
      Topic: /trajectory_follower/ground_truth_path
      Color: 0; 230; 118
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.06
      Buffer Length: 1

    - Class: rviz/Odometry
      Name: SLAM estimate
      Enabled: true
      Topic: /rtabmap/odom
      Keep: 2000
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Alpha: 0.9
        Color: 255; 145; 0
        Head Length: 0.12
        Head Radius: 0.06
        Shaft Length: 0.25
        Shaft Radius: 0.03
        Value: Arrow
      Covariance:
        Value: false

    # ---- what the robot is perceiving ---------------------------------------

    - Class: rviz/Map
      Name: RTAB-Map grid
      Enabled: true
      Topic: /rtabmap/grid_map
      Alpha: 0.5
      Color Scheme: map
      Draw Behind: true

    - Class: rviz/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic: /velodyne_points
      Size (m): 0.03
      Style: Points
      Alpha: 0.35
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0

    - Class: rviz/PointCloud2
      Name: Obstacles (segmented)
      # Apuntaba a /husky/obstacles_cloud, que no existe: copiado del paquete
      # differential a un config que comparten las TRES plataformas.  El topic
      # real lo publica rtabmap y es independiente de la plataforma.
      Enabled: true
      Topic: /rtabmap/cloud_obstacles
      Size (m): 0.05
      Style: Points
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Decay Time: 0

    # ---- the platform -------------------------------------------------------

    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
      Alpha: 1
      TF Prefix: ""

    - Class: rviz/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.6

  Enabled: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 32
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 3.9
      Near Clip Distance: 0.01
      Target Frame: base_link
    Saved:
      - Class: rviz/Orbit
        Name: Follow the robot
        Distance: 14
        Pitch: 0.9
        Yaw: 3.9
        Target Frame: base_link
      - Class: rviz/Orbit
        Name: Whole route
        Distance: 95
        Pitch: 1.4
        Yaw: 3.14
        Focal Point:
          X: -20
          Y: 18
          Z: 0
        Target Frame: map
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1700
  QMainWindow State: 
