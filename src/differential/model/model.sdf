    <!-- ================= CAMERA ================= -->

    <link name='camera_link'>
      <!-- SENSOR STANDARDIZATION: native "0.52 0 0.35". Referred to the
           Rocker-Bogie camera pose, which sits 0.3543 m ahead of the contact
           polygon centre and 0.7607 m above the contact plane:
             x = 0.3543 (this model's contact polygon is centred on x = 0)
             z = 0.7607 + (-0.1428) = 0.6179
           Forward is +x here, whereas the Rocker-Bogie's body frame has
           forward = -x, hence the sign difference in x and the absence of the
           yaw = pi that the Rocker-Bogie camera needs. -->
      <pose>0.3543 0 0.6179 0 0 0</pose>
      <inertial>
        <mass>0.00994392</mass>
        <inertia>
          <ixx>9.94392e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.94392e-05</iyy>
          <iyz>0</iyz>
          <izz>9.94392e-05</izz>
        </inertia>
      </inertial>

      <collision name='camera_collision'>
        <geometry>
          <box>
            <size>0.03 0.08 0.03</size>
          </box>
        </geometry>
      </collision>

      <visual name='camera_visual'>
        <geometry>
          <box>
            <size>0.03 0.08 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Sensor de Camara -->
      <sensor name='camera_sensor' type='camera'>
        <update_rate>10</update_rate>
        <camera name='head'>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name='camera_controller' filename='libgazebo_ros_camera.so'>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>camera</cameraName>
          <imageTopicName>/camera/image_raw</imageTopicName>
          <cameraInfoTopicName>/camera/camera_info</cameraInfoTopicName>
          <frameName>husky/camera_optical_frame</frameName>
          <hackBaseline>0.07</hackBaseline>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </link>

    <joint name='camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Optical frame -->
    <link name='camera_optical_frame'>
      <pose relative_to="camera_link">0 0 0 -1.5707963267948966 0 -1.5707963267948966</pose>
      <inertial>
        <mass>0.000994392</mass>
        <inertia>
          <ixx>9.94392e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.94392e-06</iyy>
          <iyz>0</iyz>
          <izz>9.94392e-06</izz>
        </inertia>
      </inertial>
    </link>

    <joint name='camera_optical_joint' type='fixed'>
      <parent>camera_link</parent>
      <child>camera_optical_frame</child>
    </joint>

    <!-- ================= CONTROLLER PLUGIN ================= -->
    <!--
      gazebo_ros_control, the SAME loop the Rocker-Bogie and the Tracked
      platform run.  This replaced libgazebo_ros_skid_steer_drive.so.

      Why the plugin had to go: it does not run a controller at all.  It writes
      a target velocity and an fmax straight onto the ODE joint motor, which is
      a RIGID velocity source - it tracks the command with ZERO droop until it
      saturates at fmax.  The other two platforms reach their torque ceiling
      through a soft PID velocity loop that sags under load.  Equalising the
      torque ceilings did not make the three comparable while one of them had a
      fundamentally different response to load; K_F was infinite here and
      2333.98 N/(m/s) on the other two.  See the velocity_loop section of
      sim_config.yaml for the gains, which are derived from that same K_F.

      Two per-platform command-path fudges went with the plugin:
        - a 2.0 m/s^2 command slew rate the other two never had;
        - the plugin's own odometry, already disabled because the study takes
          odometry from RTAB-Map.
      cmd_vel is now converted to wheel velocities by differential/scripts/
      twist_to_wheels.py, mirroring twist_to_tracks.py on the tracked platform,
      and joint states come from joint_state_controller instead of the fake
      joint_state_publisher that used to stand in for them.
    -->
    <plugin name='gazebo_ros_control' filename='libgazebo_ros_control.so'>
      <robotNamespace>/husky</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>false</legacyModeNS>
    </plugin>

  </model>
</sdf>
