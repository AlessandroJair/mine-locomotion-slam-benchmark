<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="husky">
  <!-- ==================== MASS MATCHING ====================
       Every <mass> and every inertia component in this file has been
       multiplied by 0.994392 = 45.0 / 45.2538 so that the three compared
       platforms have the same total mass (45.0 kg); this model natively
       weighed 45.2538 kg.  Uniform scaling leaves the centre of gravity and
       all geometry untouched.  SDF has no expression support, so the
       literals are pre-multiplied - divide by 0.994392 to recover the native
       model.
       ============================================================ -->
    <pose>0 0 .5 0 0 0</pose>
    
    <!-- Main Chassis -->
    <link name="base_link">
      <!-- Physics -->
      <collision name="collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>1.0074 0.5709 0.2675</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>33.6651</mass>
        <pose>-0.0856132 -0.000839955 0.238145 0 0 0</pose>
        <inertia>
          <ixx>2.22177</ixx>
          <ixy>-0.0235094</ixy>
          <ixz>0.273631</ixz>
          <iyy>3.40597</iyy>
          <iyz>0.0023828</iyz>
          <izz>2.11219</izz>
        </inertia>
      </inertial>
      
      <!-- Visual -->
      <!-- Base frame -->
      <visual name="base">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://husky/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/FlatBlack</name>
          </script>
        </material>
      </visual>
      
      <!-- Top Plate -->
      <visual name="top_plate">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://husky/meshes/top_plate.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Yellow</name>
          </script>
        </material>
      </visual>
      
      <!-- Front Bumper -->
      <visual name="front_bumper">
        <pose>0.47 0 0.091 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://husky/meshes/bumper.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/FlatBlack</name>
          </script>
        </material>
      </visual>
      
      <!-- Rear Bumper -->
      <visual name="rear_bumper">
        <pose>-0.47 0 0.091 0 0 3.141</pose>
        <geometry>
          <mesh>
            <uri>model://husky/meshes/bumper.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/FlatBlack</name>
          </script>
        </material>
      </visual>
      
      <!-- User Rail -->
      <visual name="user_rail">
        <pose>0.272 0 0.245 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://husky/meshes/user_rail.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- ================= VELODYNE VLP-16 LIDAR ================= -->
    <link name="velodyne_base_link">
      <!-- SENSOR STANDARDIZATION (see robot_metrics/README.md section 1.5).
           Native pose was "0 0 0.4", i.e. 0.4 + 0.0377 (internal sensor pose)
           - (-0.1428) (contact plane) = 0.5805 m above the wheel contact plane.
           All three platforms are referred to a COMMON ray-origin height so
           that a given chassis tilt displaces every LiDAR by the same amount:

             z_link = 0.9000 + (-0.1428) - 0.0377 = 0.7195

           RAISED FROM 0.8248 m TO 0.9000 m on 2026-08-26.  0.8248 m was the
           Rocker-Bogie's native height and it sits so close to the chassis
           tops that the LOWEST of the 16 rings clips the robot's own geometry:
           swept over the visuals of every link, the -15 deg ring was blocked
           by 7.5 deg here (by camera_link, at r = 0.371 m), and 0.87% of the
           sphere came back empty.  The monolithic gpu_ray never showed it -
           Gazebo does not let a ray sensor see the visual of its own link, and
           the Velodyne hangs off exactly that link - but the sliced LiDAR's
           wedge rides on a link of its own (velodyne_rotor_link), so the whole
           robot turns opaque to it and those rings simply vanish.  At 0.9000 m
           every ring clears every part of all three chassis: margin 3.5 deg
           here, 5.3 deg on the tracked, 4.2 deg on the Rocker-Bogie.

           The 0.83 kg sensor mass is retained at the new height; the mast that
           carries it is treated as massless (see README section 1.5).

           KEEP IN SYNC with differential/urdf_xacro/husky.urdf.xacro.  This
           SDF is what Gazebo spawns; the xacro is what robot_state_publisher
           turns into TF.  They disagreed by 0.2443 m until 2026-08-26 - the
           xacro still carried the native 0.4 - so every cloud was transformed
           as if its rays had left a quarter of a metre below where they
           actually did. -->
      <pose>0 0 0.7195 0 0 0</pose>
      <inertial>
        <mass>0.825345</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.000994392</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000994392</iyy>
          <iyz>0</iyz>
          <izz>0.000994392</izz>
        </inertia>
      </inertial>
      
      <!-- Visual del Velodyne -->
      <collision name='velodyne_base_collision'>
        <geometry>
          <cylinder>
            <radius>0.0516</radius>
            <length>0.0717</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name='velodyne_base_visual'>
        <geometry>
          <cylinder>
            <radius>0.0516</radius>
            <length>0.0717</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      
      <!-- Sensor LiDAR Velodyne VLP-16 -->
      <sensor name='velodyne-VLP16' type='gpu_ray'>
        <pose>0 0 0.0377 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1875</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>130.0</max>
            <resolution>0.001</resolution>
          </range>
          <!-- ==================== LIDAR NOISE ====================
               Single seeded source.  This model used to declare 0.008 here AND
               0.008 in the plugin's <gaussianNoise> below: two independent
               Gaussians that add in quadrature, so the LiDAR actually saw
               0.008*sqrt(2) = 0.011314 m, not the 0.008 the paper would state.
               Worse, the plugin's half was outside any seed - symbol inspection
               shows libgazebo_ros_velodyne_gpu_laser.so imports the C library's
               rand(), while this <noise> block goes through Gazebo's
               ignition::math::Rand, which the gzserver seed option does
               control.

               The effective noise level is deliberately UNCHANGED at 0.011314 m
               so this does not alter the experiment; it is simply moved
               entirely into the seeded generator and stated correctly.
               ==================================================== -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.011314</stddev>
          </noise>
        </ray>

        <plugin name='gazebo_ros_laser_controller' filename='libgazebo_ros_velodyne_gpu_laser.so'>
          <topicName>/velodyne_points</topicName>
          <frameName>husky/velodyne_base_link</frameName>
          <min_range>0.9</min_range>
          <max_range>130.0</max_range>
          <!-- Zero: all LiDAR noise now comes from the seeded <noise> block. -->
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </link>

    <!-- Joint para montar el Velodyne al Husky -->
    <joint name='velodyne_base_mount_joint' type='fixed'>
      <parent>base_link</parent>
      <child>velodyne_base_link</child>
    </joint>

    <!-- ================= IMU SENSOR ================= -->
    <link name='imu_link'>
      <!-- SENSOR STANDARDIZATION: el IMU va en el CENTRO DE MASAS; el
           razonamiento completo esta en model/differential/model.sdf, que es
           el fichero que Gazebo spawnea.  Esta copia existe solo para que
           extract_robot_specs.py lea lo mismo.  MUST MATCH aquel. -->
      <pose>-0.063983 -0.000629 0.199726 0 0 0</pose>
      <inertial>
        <mass>0.0149159</mass>
        <inertia>
          <ixx>9.94392e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.94392e-05</iyy>
          <iyz>0</iyz>
          <izz>9.94392e-05</izz>
        </inertia>
      </inertial>
      
      <collision name='imu_collision'>
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
      </collision>
      
      <visual name='imu_visual'>
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      
      <!-- Sensor IMU -->
      <sensor name='imu_sensor' type='imu'>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.009</stddev>
                <bias_mean>0.00075</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                <precision>0.00025</precision>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.021</stddev>
                <bias_mean>0.05</bias_mean>
                <bias_stddev>0.0075</bias_stddev>
                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                <precision>0.005</precision>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        
        <plugin name='imu_plugin' filename='libgazebo_ros_imu_sensor.so'>
          <topicName>/imu/data_raw</topicName>
          <bodyName>imu_link</bodyName>
          <updateRateHZ>100.0</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>husky/imu_link</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>
    </link>

    <joint name='imu_joint' type='fixed'>
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- ================= WHEELS ================= -->
    
    <!-- Back Left Wheel -->
    <link name="back_left_wheel">
      <pose>-0.256 0.285475 0.035 0 0 0</pose>
      <inertial>
        <mass>2.62092</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0245304</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0245304</iyy>
          <iyz>0</iyz>
          <izz>0.0438584</izz>
        </inertia>
      </inertial>
      <collision name="back_left_wheel_collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.148</radius>
            <length>0.1143</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
              <slip1>0.0</slip1>
              <slip2>0.1</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="back_left_wheel">
        <pose>0 0 0 -3.14159 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://husky/meshes/wheel.stl</uri>
            <scale>0.832396 1.0 0.832396</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
    </link>
    
    <joint name="back_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>back_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0.000000</cfm>
            <erp>0.900000</erp>
          </limit>
        </ode>
      </physics>
    </joint>
    
    <!-- Back Right Wheel -->
    <link name="back_right_wheel">
      <pose>-0.256 -0.285475 0.035 0 0 0</pose>
      <inertial>
        <mass>2.62092</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0245304</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0245304</iyy>
          <iyz>0</iyz>
          <izz>0.0438584</izz>
        </inertia>
      </inertial>
      <collision name="back_right_wheel_collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.148</radius>
