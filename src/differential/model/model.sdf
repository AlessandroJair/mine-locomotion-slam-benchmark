        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0245304</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0245304</iyy>
          <iyz>0</iyz>
          <izz>0.0438584</izz>
        </inertia>
