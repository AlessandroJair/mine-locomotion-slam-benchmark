<xacro:property name="Acople_Rodamiento_1_1__z" value="${((1.39525*mass_scale)*((-0.002333)) + (0.160204*mass_scale)*((-0.053192 + bogie_drop)+(-0.086551)+(-0.033371)) + (0.27687*mass_scale)*((-0.053192 + bogie_drop)+(-0.086551)+(-0.034916)) + (0.37221*mass_scale)*((-0.053192 + bogie_drop)+(-0.043276)) + (0.37221*mass_scale)*((-0.053192 + bogie_drop)+(-0.043276)) + (0.240385*mass_scale)*((-0.053192 + bogie_drop)+(-0.086551)+(rk_p74)+(-0.039525)) + (3.81127*mass_scale)*((-0.053192 + bogie_drop)+(-0.086551)+(rk_p74)+(rk_p79)+(rk_p58)+(-4.6319285642130973e-07)) + (0.21391*mass_scale)*((-0.053192 + bogie_drop)+(-0.086551)+(rk_p74)+(rk_p79)+(-0.047494)))/Acople_Rodamiento_1_1__m}"/>
<link name="Acople_Rodamiento_1_1">
  <inertial>
    <origin xyz="${Acople_Rodamiento_1_1__x} ${Acople_Rodamiento_1_1__y} ${Acople_Rodamiento_1_1__z}" rpy="0 0 0"/>
    <mass value="${Acople_Rodamiento_1_1__m}"/>
