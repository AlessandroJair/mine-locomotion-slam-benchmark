<!-- ================= WHEEL CONTACT SENSORS ================= -->
<!--
  One contact sensor per wheel, added to produce the measured wheel-ground
  contact figure that replaces Fig. 2 (which was drawn from an idealised MATLAB
  model and does not necessarily reflect what the physics engine does).

  Each sensor publishes gazebo_msgs/ContactsState on
      /wheel_contacts/<link name>
  from which metrics_logger.py derives, per wheel and per sample:
      * contact      - boolean, true when the states array is non-empty;
      * normal force - |total_wrench.force|, in newtons.

  The collision element referenced below is named "<link>_collision": that is
  the name Gazebo's URDF parser assigns to a link's single unnamed <collision>.
  If a wheel ever gains a second collision the names become
  "<link>_collision_1" etc. and these references must be updated, otherwise the
  sensor silently reports no contact for ever.

  update_rate is 100 Hz, twice the 50 Hz logging rate, so a contact event
  shorter than one log sample is still caught by the sensor and latched.

  Wheel naming (see sim_config.yaml):
      Rueda_5_1 front-left    Rueda_2_1 front-right
      Rueda_3_1 middle-left   Rueda_4_1 middle-right
      Rueda_1_1 rear-left     Rueda_6_1 rear-right
-->

<gazebo reference="Rueda_1_1">
  <sensor name="contact_Rueda_1_1" type="contact">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <contact>
      <collision>Rueda_1_1_collision</collision>
    </contact>
    <plugin name="bumper_Rueda_1_1" filename="libgazebo_ros_bumper.so">
      <bumperTopicName>/wheel_contacts/Rueda_1_1</bumperTopicName>
      <frameName>world</frameName>
    </plugin>
  </sensor>
</gazebo>

<gazebo reference="Rueda_2_1">
  <sensor name="contact_Rueda_2_1" type="contact">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <contact>
      <collision>Rueda_2_1_collision</collision>
    </contact>
    <plugin name="bumper_Rueda_2_1" filename="libgazebo_ros_bumper.so">
      <bumperTopicName>/wheel_contacts/Rueda_2_1</bumperTopicName>
      <frameName>world</frameName>
    </plugin>
  </sensor>
</gazebo>

