<!-- ================= PASSIVE SUSPENSION JOINT STATES ================= -->
<!--
  The bogie pivots have no transmission (that is what makes them passive), so
  gazebo_ros_control does not know about them and they never appear in
  /rocker_bogie/joint_states.  Their angles are nonetheless the quantity of
  interest for the suspension analysis, so they are published directly by
  Gazebo on a dedicated topic.

  rocker_differential.py consumes this topic, which also keeps the differential
  independent of controller-spawn ordering.
-->
<gazebo>
  <plugin name="suspension_joint_state_publisher"
          filename="libgazebo_ros_joint_state_publisher.so">
    <robotNamespace>/rocker_bogie</robotNamespace>
    <jointName>rocker_pivot_left, rocker_pivot_right, rev_3, rev_4</jointName>
    <!-- NO PONGAS <topicName> AQUI.  gazebo_plugins 2.9.3 no lo lee: el
         nombre "joint_states" esta hardcodeado en el plugin (compruebalo con
         `strings libgazebo_ros_joint_state_publisher.so | grep -x topicName`,
         que no devuelve nada) y el topic sale siempre en
         <robotNamespace>/joint_states, aqui /rocker_bogie/joint_states.
         Un <topicName> puesto aqui no falla: se ignora en silencio, y el que
         lo lea creera que el topic se llama de otra forma.  Eso costo una
         campana entera con las columnas de suspension en NaN (2026-09-10).

         OJO: el joint_state_controller de ros_control publica en ESE MISMO
         topic, en el mismo namespace, con los 12 joints actuados.  Los dos
         mensajes se alternan, asi que quien lea de aqui tiene que buscar POR
         NOMBRE y no por indice. -->
    <updateRate>200</updateRate>
    <alwaysOn>true</alwaysOn>
  </plugin>
</gazebo>

<!-- ================= VELODYNE VLP-16 SENSOR ================= -->
<gazebo reference="velodyne_base_link">
  <sensor name="velodyne-VLP16" type="gpu_ray">
    <pose>0 0 0.0641 0 0 0</pose>
    <visualize>false</visualize>
    <update_rate>10</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>1875</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
        <vertical>
          <samples>16</samples>
          <resolution>1</resolution>
          <min_angle>-0.261799</min_angle>
          <max_angle>0.261799</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.3</min>
        <max>101.0</max>
        <resolution>0.001</resolution>
      </range>
      <!-- ==================== LIDAR NOISE ====================
           Single seeded source.  This model used to declare 0.008 here AND
           0.008 in the plugin's <gaussianNoise> below: two independent
           Gaussians that add in quadrature, so the LiDAR actually saw
           0.008*sqrt(2) = 0.011314 m, not the 0.008 the paper would state.
           Worse, the plugin's half was outside any seed - symbol inspection
           shows libgazebo_ros_velodyne_gpu_laser.so imports the C library's
           rand(), while this <noise> block goes through Gazebo's
           ignition::math::Rand, which the gzserver seed option does control.

           The effective noise level is deliberately UNCHANGED at 0.011314 m so
           this does not alter the experiment; it is simply moved entirely into
           the seeded generator and stated correctly.
           ==================================================== -->
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.011314</stddev>
      </noise>
    </ray>
    <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_velodyne_gpu_laser.so">
      <topicName>/velodyne_points</topicName>
      <frameName>rocker_bogie/velodyne_base_link</frameName>
      <min_range>0.9</min_range>
      <max_range>100.0</max_range>
      <!-- Zero: all LiDAR noise now comes from the seeded <noise> block. -->
      <gaussianNoise>0.0</gaussianNoise>
    </plugin>
  </sensor>
</gazebo>

<!-- ================= IMU SENSOR ================= -->
<gazebo reference="imu_link">
  <gravity>true</gravity>
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>__default_topic__</topic>
    <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
      <topicName>/imu/data_raw</topicName>
      <bodyName>imu_link</bodyName>
      <updateRateHZ>100.0</updateRateHZ>
      <gaussianNoise>0.0</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
      <frameName>rocker_bogie/imu_link</frameName>
      <initialOrientationAsReference>false</initialOrientationAsReference>
    </plugin>
    <pose>0 0 0 0 0 0</pose>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0.00075</bias_mean><bias_stddev>0.005</bias_stddev><dynamic_bias_stddev>0.00002</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.00025</precision></noise></x>
        <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0.00075</bias_mean><bias_stddev>0.005</bias_stddev><dynamic_bias_stddev>0.00002</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.00025</precision></noise></y>
        <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0.00075</bias_mean><bias_stddev>0.005</bias_stddev><dynamic_bias_stddev>0.00002</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.00025</precision></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.0075</bias_stddev><dynamic_bias_stddev>0.000375</dynamic_bias_stddev><dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time><precision>0.005</precision></noise></x>
        <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.0075</bias_stddev><dynamic_bias_stddev>0.000375</dynamic_bias_stddev><dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time><precision>0.005</precision></noise></y>
        <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.0075</bias_stddev><dynamic_bias_stddev>0.000375</dynamic_bias_stddev><dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time><precision>0.005</precision></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<!-- ================= CAMERA SENSOR ================= -->
<gazebo reference="camera_link">
  <sensor name="camera_sensor" type="camera">
    <update_rate>10</update_rate>
    <camera name="head">
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.007</stddev>
      </noise>
    </camera>
    <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>0.0</updateRate>
      <cameraName>camera</cameraName>
      <imageTopicName>/camera/image_raw</imageTopicName>
      <cameraInfoTopicName>/camera/camera_info</cameraInfoTopicName>
      <frameName>rocker_bogie/camera_optical_frame</frameName>
      <hackBaseline>0.07</hackBaseline>
      <distortionK1>0.0</distortionK1>
      <distortionK2>0.0</distortionK2>
      <distortionK3>0.0</distortionK3>
      <distortionT1>0.0</distortionT1>
      <distortionT2>0.0</distortionT2>
    </plugin>
  </sensor>
</gazebo>

<!-- SENSORES COMO LINKS PROPIOS (2026-09-13).  Sin esto la conversion
     URDF->SDF fusiona LiDAR, IMU y camara en el chasis; el husky y el tracked
     spawnean SDF y los tienen como links unidos por junta fija.  Asi cuelgan
     igual en las tres. -->
<gazebo reference="velodyne_base_mount_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>
<gazebo reference="imu_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>
<gazebo reference="camera_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>
<gazebo reference="camera_optical_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>

</robot>
