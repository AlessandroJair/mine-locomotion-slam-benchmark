  <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
    <robotNamespace>/rocker_bogie</robotNamespace>
  </plugin>
</gazebo>

<!-- ================= BODY MATERIALS ================= -->
<gazebo reference="chassis_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>1.0</mu2>
  <self_collide>false</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="Acople_Rodamiento_1_1">
  <material>${body_color}</material>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="Acople_Rodamiento_2_1">
  <material>${body_color}</material>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="BarraRuedas_1_1">
